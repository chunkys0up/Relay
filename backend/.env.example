# AWS — used for both Bedrock (model) and S3 (document storage).
# Set AWS_PROFILE to a profile in ~/.aws/credentials (e.g. "participant" for
# the workshop account) if you're not using the default credential chain.
AWS_PROFILE=
AWS_REGION=us-east-1

# Local PDF workflow model routing. Set a fallback model/profile ID to enable
# the live team. Uncomment any role override to route that role separately.
# If there is no fallback, set all five role IDs explicitly.
BEDROCK_MODEL_OR_PROFILE_ID=
# BEDROCK_EXTRACTOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_ORCHESTRATOR_MODEL_ID=us.anthropic.claude-sonnet-5
# BEDROCK_READER_MODEL_ID=us.anthropic.claude-sonnet-5
# BEDROCK_WRITER_MODEL_ID=us.anthropic.claude-sonnet-5
# BEDROCK_VERIFIER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# App settings
APP_NAME=Relay Agent API
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Strands harness settings — runs on Bedrock via the AWS credentials above.
STRANDS_MODEL=bedrock/us.anthropic.claude-sonnet-5
STRANDS_EFFORT=auto
SESSION_DIR=./.agent/sessions

LOG_LEVEL=INFO

# S3 document storage
S3_BUCKET=relay-documents-576248046713

# RDS Postgres (see db/schema.sql for the schema)
DB_HOST=
DB_PORT=5432
DB_NAME=relay
DB_USER=relay_admin
DB_PASSWORD=
