# Model provider credentials — set the one matching STRANDS_MODEL below.
# Leave STRANDS_MODEL unset to use the harness default (Amazon Bedrock Claude),
# which needs either AWS_BEARER_TOKEN_BEDROCK or a configured AWS CLI profile.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# App settings
APP_NAME=Relay Agent API
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Strands harness settings
STRANDS_MODEL=
STRANDS_EFFORT=auto
SESSION_DIR=./.agent/sessions

LOG_LEVEL=INFO
