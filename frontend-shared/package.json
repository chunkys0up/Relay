{
  "name": "relay-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "cd .. && eslint --config frontend-shared/eslint.config.js .",
    "typecheck": "tsc --noEmit",
